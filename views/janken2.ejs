<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>ラジオボタンじゃんけん</title>
</head>
<body>
    <h1>じゃんけん</h1>

    <p>あなたの手：<%= your %></p>
    <p>コンピュータの手：<%= cpu %></p>
    <p>判定：<%= judgement %></p>
    <p>現在<%= total %>試合中<%= win %>勝しています。</p>

    <hr>

    <form action="/janken2" method="get">
        <p>次の手を選んでください。</p>

        <input type="radio" name="hand" id="rock" value="グー" required>
        <label for="rock">グー</label>

        <input type="radio" name="hand" id="scissors" value="チョキ">
        <label for="scissors">チョキ</label>

        <input type="radio" name="hand" id="paper" value="パー">
        <label for="paper">パー</label>

        <input type="hidden" name="win" value="<%= win %>">
        <input type="hidden" name="total" value="<%= total %>">
        <button type="submit">じゃんけん ポン</button>
    </form>
</body>
</html>
