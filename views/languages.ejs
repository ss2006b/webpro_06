<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>プログラミング言語一覧</title>
</head>
<body>
    <h1>プログラミング言語一覧</h1>
    <table border="1">
        <thead>
            <tr>
                <th>ID</th>
                <th>言語名</th>
                <th>登場年</th>
                <th>開発者</th>
            </tr>
        </thead>
        <tbody>
            <% for (const row of data) { %>
                <tr>
                    <td><%= row.id %></td>
                    <td><%= row.name %></td>
                    <td><%= row.year %></td>
                    <td><%= row.creator %></td>
                </tr>
            <% } %>
        </tbody>
    </table>
    <p><a href="/public/language_add.html">言語を追加する</a></p>
</body>
</html>
